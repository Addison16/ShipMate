# Copy to .env for local development. docker-compose.yml sets these for containers.
SHIPMATE_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://shipmate:shipmate@localhost:5432/shipmate
# Generated on first boot if empty; keep it stable or stored secrets become unreadable.
SHIPMATE_SECRET=
SHIPMATE_DATA_DIR=./data
# Server integration tests wipe this database; never point it at real data.
# TEST_DATABASE_URL=postgres://shipmate:shipmate@localhost:5432/shipmate_test
# Shipyard sandboxes: run code in per-project containers through a Docker-compatible API.
# The owner can also set this in Settings → Shipyard sandbox. See docs/shipyard.md.
# DOCKER_SOCKET=/var/run/docker.sock
# Or Docker's own variables: rootless Podman's socket, or a remote host with TLS certificates.
# DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
# DOCKER_HOST=tcp://sandbox-host.lan:2376
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/data/sandbox-certs   # ca.pem, cert.pem, key.pem
# Where a remote sandbox host sees Shipmate's workspaces folder (e.g. an NFS mount).
# SHIPMATE_SANDBOX_WORKSPACES=/mnt/shipmate/workspaces
# SHIPMATE_SANDBOX_IMAGE=node:22-bookworm
# When Shipmate itself runs in Docker, the host path of its /data volume, so sandbox bind
# mounts point at the host (e.g. /srv/shipmate/data). Unset when running Shipmate on the host.
# SHIPMATE_HOST_DATA_DIR=
# Shipyard integration tests use their own database (wiped on every run).
# TEST_DATABASE_URL_SHIPYARD=postgres://shipmate:shipmate@localhost:5432/shipmate_test_a
# Discord: no env needed. The owner pastes the bot token on the Discord page (stored encrypted)
# and must enable the bot's Message Content intent in the Discord developer portal.
# Discord integration tests use their own database (wiped on every run).
# TEST_DATABASE_URL_DISCORD=postgres://shipmate:shipmate@localhost:5432/shipmate_test_b
# Web Push: extra push service hosts to accept subscriptions from, besides the browser makers'.
# SHIPMATE_PUSH_HOSTS=push.example.org
# Ollama for local models: the address checked first (docker-compose's optional service by
# default; http://localhost:11434 when you run Ollama next to `pnpm dev`).
# SHIPMATE_OLLAMA_URL=http://localhost:11434
# Health page: "off" never asks GitHub for new releases (offline installs).
# SHIPMATE_UPDATE_CHECK=on
# One-click updates: the helper image, and Shipmate's container name if not its hostname.
# SHIPMATE_UPDATER_IMAGE=containrrr/watchtower:latest
# SHIPMATE_CONTAINER=shipmate
