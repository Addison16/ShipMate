      "gmail",
      "calendar",
      "drive",
      "docs",
      "sheets",
      "tasks"
    ],
    "secrets": [
      { "env": "GOOGLE_OAUTH_CLIENT_ID", "label": "Client ID" },
      { "env": "GOOGLE_OAUTH_CLIENT_SECRET", "label": "Client secret" }
    ],
