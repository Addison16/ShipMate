    "args": ["mcp-server-git"],
    "tags": ["dev"]
  },
  {
    "id": "github",
    "name": "GitHub",
    "description": "Issues, pull requests, repositories and actions.",
    "tier": "core",
    "transport": "http",
    "url": "https://api.githubcopilot.com/mcp/",
    "secrets": [{ "env": "GITHUB_PERSONAL_ACCESS_TOKEN", "label": "GitHub token" }],
    "tags": ["dev"]
  },
  {
    "id": "fetch",
