    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "mcp-searxng"],
    "secrets": [
      { "env": "SEARXNG_URL", "label": "SearXNG URL", "required": false },
      { "env": "BRAVE_API_KEY", "label": "Brave API key", "required": false }
    ],
    "tags": ["web"]
  },
